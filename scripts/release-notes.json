          {
            "kind": "add",
            "text": "浅色选中、深色选中及全部图标颜色自定义。"
          },
          {
            "kind": "opt",
            "text": "设置页的使用说明与更新日志改为原位下拉拉伸，不再弹出独立页面。"
          },
          {
            "kind": "opt",
            "text": "iOS 26+ 使用 UIKit 系统原生 Liquid Glass；不使用 CSS 自绘玻璃。"
          },
          {
            "kind": "opt",
            "text": "iOS 25 及以下自动回退 UIKit 原生 systemMaterial 磨砂。"
          },
          {
            "kind": "opt",
            "text": "规则页移除图片导入入口，只保留规则名称与图标规则名。"
          },
          {
            "kind": "fix",
            "text": "规则页安全区，避免标题与状态栏重叠。"
          }
        ]
      },
      {
        "version": "1.0.0",
        "entries": [
          {
            "kind": "add",
            "text": "优优 LUI 图标补全基础功能。"
