        },
        {
          "kind": "fix",
          "text": "恢复修改后的更新日志；修复首页删除图标、滚动缩小底栏及设置同步。"
        }
      ]
    }
  },
  "exclusive_history_by_version": {
    "1.0.5": [
      {
        "version": "1.0.4",
        "entries": [
          {
            "kind": "add",
            "text": "主题支持工具栏卡片透明度、滚动缩小底栏及自定义背景图片；设置自动保存。"
          },
          {
            "kind": "add",
            "text": "底栏搜索改为关闭、合并、分开三段切换，保留已保存的搜索布局；关闭后恢复顶部搜索框。"
          },
          {
            "kind": "opt",
            "text": "相同或相近用途的图标合并为一个上传入口，共用图标归原版微信；LiquidUI 分类保留专属入口，导出保留全部对应文件名。"
          },
          {
            "kind": "opt",
            "text": "首页上传项每排两列，左图右标题；LiquidUI 与原版微信的导入项和规则分组标题统一缩小；更新规则按大标题合并展示。"
          },
          {
            "kind": "opt",
            "text": "导出 ZIP 改名使用系统原生弹窗。"
          },
          {
            "kind": "opt",
            "text": "补全图片和自定义颜色入口略微加粗描边，增加柔和淡色底。"
          },
          {
            "kind": "opt",
            "text": "首页工具卡片改用纯色，其他卡片保持原生材质。"
          },
          {
            "kind": "opt",
            "text": "清空固定蓝色、白色文字；导出 ZIP 固定绿色、白色文字。"
          },
          {
            "kind": "opt",
            "text": "首页分类和设置切换同步配色：未选中底色跟随卡片颜色，选中底色跟随按钮颜色。"
          },
          {
            "kind": "fix",
            "text": "合并和分开底栏搜索均可点击，打开原生全屏搜索页，自动弹出键盘，关闭后返回原页面。"
          },
          {
            "kind": "fix",
            "text": "深色液态玻璃下六个按钮不明显，按钮保持独立纯色并自动适配文字颜色。"
          },
          {
            "kind": "fix",
            "text": "原生底栏文字跟随导入字体，恢复默认和重新打开也同步生效。"
          },
          {
            "kind": "fix",
            "text": "分开搜索改用系统原生独立搜索标签，底栏与搜索统一对齐、尺寸及安全区位置。"
          }
        ]
      },
      {
        "version": "1.0.3",
        "entries": [
          {
            "kind": "add",
            "text": "主题增加按钮颜色，首页按钮与分类底色同步；浅色、深色分别保存。"
          },
          {
            "kind": "add",
            "text": "跟随系统、浅色与深色外观；背景颜色分别保存并随外观切换。"
          },
          {
            "kind": "opt",
            "text": "搜索框位于反馈问题下方，随材质切换为液态玻璃或原生磨砂。"
          },
          {
            "kind": "opt",
            "text": "首页六个操作按钮保持纯色，其他卡片保留原有材质。"
          },
          {
            "kind": "opt",
            "text": "分类未选中底色使用按钮颜色，增加透明度以呈现柔和层次。"
          },
          {
            "kind": "opt",
            "text": "分类、材质与外观使用紧凑原生分段控件；缩短设置卡片。"
          },
          {
            "kind": "opt",
            "text": "移除自定义卡片描边，鸣谢仅在设置页随内容排布。"
          },
          {
            "kind": "fix",
            "text": "展开动画结束时的高度跳动和重复点击状态。"
          }
        ]
      },
      {
        "version": "1.0.2",
        "entries": [
          {
            "kind": "add",
            "text": "卡片液态效果开关；关闭后切换为 UIKit 原生磨砂效果。"
          },
          {
            "kind": "add",
            "text": "主题内自定义字体，可导入 TTF、OTF、WOFF、WOFF2 文件并持久保存。"
          },
          {
            "kind": "add",
            "text": "卡片材质、液态玻璃、原生磨砂两种模式直接切换/低于26+不生效液态玻璃。"
          },
          {
            "kind": "add",
            "text": "主题增加卡片颜色，可修改纯色卡片颜色"
          },
          {
            "kind": "opt",
            "text": "规则页移除图片导入入口，仅显示规则名称与图标规则名。"
          },
          {
            "kind": "opt",
            "text": "首页采用新的双列卡片UI，上传区工具区与顶部信息重新布局。"
          },
          {
            "kind": "opt",
            "text": "设置页入口卡片进一步压缩高度与文字尺寸。"
          },
          {
            "kind": "opt",
            "text": "首页白色工具控件、搜索框、颜色展开项、清空按钮、分类未选中项和上传框统一接入 UIKit 原生玻璃/磨砂材质。"
          },
          {
            "kind": "opt",
            "text": "材质切换与首页分类分段切换改为参考图的胶囊式，选中项使用内嵌白色圆角块。"
          },
          {
            "kind": "opt",
            "text": "首页按钮、搜索框、颜色入口与导出操作统一为分类栏同类圆润胶囊轮廓。"
          },
          {
            "kind": "opt",
            "text": "纯色模式下首页操作框统一为同一中性底色，补全图片、自定义颜色、清空等入口保持清晰可见。"
          },
          {
            "kind": "fix",
            "text": "设置页使用说明与更新日志改为原位下拉拉伸卡片。"
          },
          {
            "kind": "fix",
            "text": "规则页顶部安全区与状态栏重叠问题。"
          },
          {
            "kind": "fix",
            "text": "首页、规则、设置三页卡片视觉统一，首页工具卡不再使用单独的透明样式。"
          },
          {
            "kind": "fix",
            "text": "使用说明、更新日志与主题卡片收起响应延迟，收起动画改为快速响应。"
          },
          {
            "kind": "fix",
            "text": "纯色模式默认不显示卡片描边；只有主动开启卡片描边后才显示所选描边颜色。"
          },
          {
            "kind": "fix",
            "text": "背景颜色现在同步到 UIKit 根视图，修改后立即生效并保存。"
          },
          {
            "kind": "fix",
            "text": "首页双分类切换中间露出的白色材质块；分类容器不再重复叠加玻璃。"
          },
          {
            "kind": "fix",
            "text": "液态玻璃与原生磨砂在刷新、筛选和重绘时原生材质层重新绑定导致的跳动。"
          }
        ]
      },
      {
        "version": "1.0.1",
        "entries": [
          {
            "kind": "add",
            "text": "全局换图标规则页，可按规则名称与图标规则名查找。"
          },
          {
            "kind": "add",
            "text": "关键词批量导入、双分类补全、同名项目自动联动与 ZIP 自定义名称分享。"
