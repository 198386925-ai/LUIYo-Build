g","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 标为已读","file":"read_lp.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 标为未读","file":"unread_lp.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 移出密友","file":"secret_remove_lp.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 移到分组…","file":"move_group_lp.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 移回全部","file":"back_all_lp.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 置顶 / 取消置顶","file":"pin_lp.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 聊天盒 · 以后走悬浮胶囊","file":"cbs_capsule.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 聊天盒 · 改回列表行","file":"cbs_list_row.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 自定义预览文字","file":"privacy_text_lp.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]},{"title":"首页长按菜单 · 进入","file":"enter_lp.png","section":"LiquidUI TabBarIcons 投放口（第二投放口）","category":"liquidui","aliases":[],"sections":["LiquidUI TabBarIcons 投放口（第二投放口）"]}];
// 底栏分为 LiquidUI 与原版微信两个分类；各自上传一次，选中版自动生成
const tabSets=[
  ['LiquidUI 底栏微信','lui_tab_main_regular@3x.png','lui_tab_main_filled@3x.png','liquidui'],
  ['底栏微信','bubble_circle_regular@3x.png','bubble_circle_filled@3x.png','wechat'],
  ['LiquidUI 底栏通讯录','lui_tab_contacts_regular@3x.png','lui_tab_contacts_filled@3x.png','liquidui'],
  ['底栏通讯录','person_list_regular@3x.png','person_list_filled@3x.png','wechat'],
  ['LiquidUI 底栏发现','lui_tab_discover_regular@3x.png','lui_tab_discover_filled@3x.png','liquidui'],
  ['底栏发现','discover_regular@3x.png','discover_filled@3x.png','wechat'],
  ['LiquidUI 底栏我的','lui_tab_me_regular@3x.png','lui_tab_me_filled@3x.png','liquidui'],
  ['底栏我的','person_regular@3x.png','person_filled@3x.png','wechat']
];
for(const [title,normal,selected,category] of tabSets){
  const idxs=items.map((x,i)=>[normal,selected].includes(x.file)?i:-1).filter(i=>i>=0);
  if(!idxs.length) continue;
  const first=idxs[0];
  items[first]={...items[first],title,file:normal,files:[normal],selectedFiles:[selected],category};
  for(let k=idxs.length-1;k>=1;k--) items.splice(idxs[k],1);
}
// A LiquidUI section name does not make a stock/shared action exclusive.
items.forEach(it=>{
  delete it.hiddenFromUI;
  const names=[...(it.files||[it.file]),...(it.selectedFiles||[])];
  it.category=names.some(n=>/^lui_/i.test(n))||/第二投放口/.test(it.section||'')?'liquidui':'wechat';
});
