mode":"normal","titles":["微信文件音乐图标命名"]},{"file":"fileicon_photo_icon_light@3x.png","targetFile":"folder_filled@3x.png","mode":"normal","titles":["微信文件图像图标命名"]},{"file":"fileicon_ofd_icon@3x.png","targetFile":"folder_filled@3x.png","mode":"normal","titles":["微信文件ofd图标命名"]},{"file":"fileicon_voice_icon_light@3x.png","targetFile":"folder_filled@3x.png","mode":"normal","titles":["微信文件MP3图标命名"]},{"file":"fileicon_video_icon_light@3x.png","targetFile":"folder_filled@3x.png","mode":"normal","titles":["微信文件视频图标命名"]},{"file":"fileicon_unknown_icon_light@3x.png","targetFile":"folder_filled@3x.png","mode":"normal","titles":["微信文件视未知命名"]}];
let extraFillApplied=false;
const chosen=new Map();
const excluded=new Set(); // 用户点 × 后，本次导出不包含这些图标；再次手动上传可恢复
const list=document.getElementById('list');
let activeCategory='wechat';
// 一个上传入口（items 的一项）对应 files + selectedFiles 里的全部文件名，上传一次导出时全部生成；
// 入口由 scripts/import-icon-rules.py 按 scripts/data/upload-groups.json 生成，不在页面里再猜同义。
function syncTitleKey(title){
  return String(title||'')
    .replace(/^LiquidUI\s*/i,'')
    .replace(/\s+/g,'')
    .trim()
    .toLowerCase();
}
function setChosenWithSync(i,f){
  chosen.set(i,f);
  excluded.delete(i);
  return 0;
}
function removeChosenWithSync(i){
  chosen.delete(i);
  excluded.add(i);
  renderList();
  updateStatus();
}
document.getElementById('count').textContent='共 '+items.length+' 个上传项';
function normalizeSearchText(v){
  return String(v??'').toLowerCase()
    .normalize('NFKC')
    .replace(/[^\p{L}\p{N}]+/gu,' ')
    .replace(/\s+/g,' ')
    .trim();
}
function itemSearchText(it){
  return normalizeSearchText([
    it.title,it.file,it.section,
    ...(it.aliases||[]),...(it.sections||[]),
    ...(it.files||[]),...(it.selectedFiles||[])
  ].filter(Boolean).join(' '));
}
function itemMatchesQuery(it,q){
  const tokens=normalizeSearchText(q).split(' ').filter(Boolean);
  if(!tokens.length)return true;
  const hay=itemSearchText(it);
  return tokens.every(t=>hay.includes(t));
}
function escapeRuleHtml(v){
  return String(v??'').replace(/[&<>"']/g,s=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s]));
}
function itemHintPrefix(it){
  let prefix='';
  if(it.alsoLiquidUI)prefix+='LiquidUI 也用 · ';
  const count=(it.files||[]).length+(it.selectedFiles||[]).length;
  if(count>1)prefix+='共 '+count+' 个文件名 · ';
  return prefix;
}
function renderList(){
  list.querySelectorAll('.preview img[data-url]').forEach(img=>URL.revokeObjectURL(img.dataset.url));
  list.innerHTML='';
  const q=document.getElementById('searchInput')?.value||'';
  items.forEach((it,i)=>{
    if(it.category!==activeCategory || !itemMatchesQuery(it,q)) return;
    const c=document.createElement('div');c.className='card'+(excluded.has(i)?' excluded':'');c.dataset.i=i;
    const removeBtn=chosen.has(i)?`<button type="button" class="removeIcon" data-remove="${i}" aria-label="移除这个图标">×</button>`:'';
    c.innerHTML=`<label class="uploadThumb" aria-label="上传${escapeRuleHtml(it.title)}图标"><span class="uploadPlus" aria-hidden="true">+</span><div class="preview" id="p${i}"><img alt="${escapeRuleHtml(it.title)}"></div><input type="file" accept="image/*" data-i="${i}"></label><div class="uploadText"><div class="title">${escapeRuleHtml(it.title.replace(/^LiquidUI\s*/,''))}</div><div class="uploadHint">${itemHintPrefix(it)}${chosen.has(i)?'已上传 · 点击左图替换':'点击左图上传'}</div></div>${removeBtn}`;
    list.appendChild(c);
    if(chosen.has(i)) showPreviewOnly(i,chosen.get(i));
  });
}
const previewThumbnails=new WeakMap();
function previewBounds(pixels,width,height){
  let left=width,top=height,right=-1,bottom=-1;
  for(let y=0;y<height;y++)for(let x=0;x<width;x++)if(pixels[(y*width+x)*4+3]>0){left=Math.min(left,x);right=Math.max(right,x);top=Math.min(top,y);bottom=Math.max(bottom,y)}
  return right<left?null:{left,top,width:right-left+1,height:bottom-top+1};
}
async function thumbnailFor(file){
  if(previewThumbnails.has(file))return previewThumbnails.get(file);
  const work=(async()=>{
    const image=await createImageBitmap(file),scale=Math.min(1,1024/Math.max(image.width,image.height));
    const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(image.width*scale));canvas.height=Math.max(1,Math.round(image.height*scale));
    const context=canvas.getContext('2d',{willReadFrequently:true});context.drawImage(image,0,0,canvas.width,canvas.height);image.close();
    const bounds=previewBounds(context.getImageData(0,0,canvas.width,canvas.height).data,canvas.width,canvas.height);
    if(!bounds)return canvas.toDataURL('image/png');
    const inset=Math.max(1,Math.ceil(Math.max(bounds.width,bounds.height)*.04)),crop=document.createElement('canvas');crop.width=bounds.width+inset*2;crop.height=bounds.height+inset*2;
    crop.getContext('2d').drawImage(canvas,bounds.left,bounds.top,bounds.width,bounds.height,inset,inset,bounds.width,bounds.height);
    return crop.toDataURL('image/png');
  })();previewThumbnails.set(file,work);return work;
}
function showPreviewOnly(i,f){
  const p=document.getElementById('p'+i);if(!p)return;const img=p.querySelector('img');if(img.dataset.url)URL.revokeObjectURL(img.dataset.url);
  const u=URL.createObjectURL(f);img.src=u;img.dataset.url=u;p.style.display='flex';
  thumbnailFor(f).then(thumbnail=>{if(img.isConnected&&chosen.get(i)===f)img.src=thumbnail}).catch(()=>{});
}
function showFile(i,f){
  setChosenWithSync(i,f);
  showPreviewOnly(i,f);
  updateStatus()
}
function updateStatus(){const total=items.filter(x=>x.category===activeCategory).length, done=[...chosen.keys()].filter(i=>items[i].category===activeCategory).length;document.getElementById('status').textContent='已上传 '+done+' / '+total+' 项';const live=document.getElementById('liveImported');if(live)live.textContent='当前上传项目：'+items.filter((it,i)=>chosen.has(i)).length+' 项'}
function switchCategory(cat){activeCategory=cat;document.getElementById('tabLui').classList.toggle('active',cat==='liquidui');document.getElementById('tabWechat').classList.toggle('active',cat==='wechat');document.getElementById('sectionTitle').textContent=cat==='liquidui'?'LiquidUI 图标':'原版微信图标';renderList();updateStatus()}
document.getElementById('tabLui').onclick=()=>switchCategory('liquidui');
document.getElementById('tabWechat').onclick=()=>switchCategory('wechat');
list.addEventListener('click',e=>{const b=e.target.closest&&e.target.closest('.removeIcon');if(!b)return;e.preventDefault();e.stopPropagation();removeChosenWithSync(+b.dataset.remove)});
list.addEventListener('change',e=>{if(!e.target.matches('input[type=file]'))return;const f=e.target.files&&e.target.files[0];if(!f)return;showFile(+e.target.dataset.i,f);renderList()});
// 批量导入：按照网页上显示的中文标题 / 关键词自动匹配，而不是要求图片使用内部资源文件名。
function importKeywordNormalize(v){
  return String(v||'')
    .replace(/\.[a-z0-9]{1,8}$/i,'')
    .replace(/liquid\s*ui/ig,'')
    .replace(/\blui\b/ig,'')
    .replace(/@\d+x/ig,'')
    .replace(/[「」『』【】\[\]（）()<>《》·•—–_\-+.,，。:：;；'\"“”‘’/\\|\s]/g,'')
    .toLowerCase();
}
function itemImportKeywords(it){
  // 批量导入关键词 = 卡片标题 + 别名（含规则表里的中文名和 1.0.7 旧标题）。LiquidUI 前缀在网页卡片里不显示，匹配时也去掉。
  const out=new Set();
  for(const title of [it.title,...(it.aliases||[])]){
    const k=importKeywordNormalize(String(title||'').replace(/^LiquidUI\s*/,'').trim());
    if(k)out.add(k);
  }
  return [...out];
}
// 文件名主干：去扩展名、@nx、_Dark/_dark，小写。
function importFileStem(name){
  return String(name||'').replace(/\.[a-z0-9]{1,8}$/i,'').replace(/@\d+x/ig,'').replace(/_dark$/i,'').trim().toLowerCase();
}
function longestCommonSubstringLen(a,b){
  if(!a||!b)return 0;
  const dp=new Array(b.length+1).fill(0);
  let best=0;
  for(let i=1;i<=a.length;i++){
    let prev=0;
    for(let j=1;j<=b.length;j++){
      const old=dp[j];
      if(a[i-1]===b[j-1]){
        dp[j]=prev+1;
        if(dp[j]>best)best=dp[j];
      }else dp[j]=0;
      prev=old;
    }
  }
  return best;
}
function findItemByWebKeyword(filename){
  const rawStem=importFileStem(filename);
  // 纯 ASCII 文件名主干（如 scan_filled、more_flame）：只精确匹配入口内任一文件名主干，不走模糊。
  if(rawStem&&/^[\x00-\x7f]+$/.test(rawStem)){
    if(rawStem.length<2) return {index:-1,ambiguous:false,tooShort:true};
    const hits=[];
    items.forEach((it,i)=>{
      if([...(it.files||[]),...(it.selectedFiles||[])].some(f=>importFileStem(f)===rawStem))hits.push(i);
    });
    if(hits.length===1) return {index:hits[0],ambiguous:false,tooShort:false};
    return {index:-1,ambiguous:hits.length>1,tooShort:false};
  }
  const stem=importKeywordNormalize(filename);
  // 完整标题可精确匹配两个字；模糊匹配需连续三个字以上，避免误导入。
  if(!stem || stem.length<2) return {index:-1,ambiguous:false,tooShort:true};
  const scored=[];
  items.forEach((it,i)=>{
    const titleKey=importKeywordNormalize(String(it.title||'').replace(/^LiquidUI\s*/,'').trim());
    for(const k of itemImportKeywords(it)){
      if(!k || k.length<2) continue;
      let score=0;
      let fuzzy=0;
      if(stem===k) score=20000+k.length;
      else if(k.length>=3 && stem.includes(k)) score=15000+k.length;
      else if(stem.length>=3 && k.includes(stem)) score=12000+stem.length;
      else {
        fuzzy=longestCommonSubstringLen(stem,k);
        if(fuzzy>=3) score=5000+fuzzy*100-Math.abs(stem.length-k.length);
      }
      if(score) scored.push({i,score,k,fuzzy,own:k===titleKey});
    }
  });
  if(!scored.length) return {index:-1,ambiguous:false,tooShort:false};
  scored.sort((a,b)=>b.score-a.score || b.k.length-a.k.length || a.i-b.i);
  const best=scored[0];
  // 平局：最高分全部属于同一入口则命中该入口；否则只有一个入口是按卡片标题命中的就取它，其余判歧义。
  const top=scored.filter(x=>x.score===best.score);
  const tied=[...new Set(top.map(x=>x.i))];
  if(tied.length>1){
    const own=[...new Set(top.filter(x=>x.own).map(x=>x.i))];
    if(own.length===1) return {index:own[0],ambiguous:false,tooShort:false};
    return {index:-1,ambiguous:true,tooShort:false};
  }
  return {index:best.i,ambiguous:false,tooShort:false};
}
document.getElementById('batchInput').addEventListener('change',e=>{
  let n=0,synced=0;
  const unmatched=[];
  const tooShort=[];
  for(const f of e.target.files){
    const result=findItemByWebKeyword(f.name);
    const i=result.index;
    if(i>=0){
      const before=chosen.size;
      setChosenWithSync(i,f);
      n++;
      synced+=Math.max(0,chosen.size-before-1);
    }else{
      if(result.tooShort) tooShort.push(f.name); else unmatched.push(f.name);
    }
  }
  renderList();updateStatus();
  e.target.value='';
  if(n){
    let msg='已按网页标题模糊关键词自动匹配 '+n+' 张图片';
    if(synced) msg+='，并同步 '+synced+' 个同名对应项';
    if(unmatched.length){
      msg+='\n\n未匹配 '+unmatched.length+' 张：\n'+unmatched.slice(0,8).join('\n');
      if(unmatched.length>8) msg+='\n…还有 '+(unmatched.length-8)+' 张';
      msg+='\n\n可使用网页标题中的模糊关键词，例如：底栏微信.png、扫一扫.png、转账.png、scan_filled.png；模糊关键词至少 3 个字，两个字请使用完整标题。';
    }
    if(tooShort.length){
      msg+='\n\n关键词少于 2 个字，已跳过 '+tooShort.length+' 张：\n'+tooShort.slice(0,8).join('\n');
    }
    alert(msg);
  }else{
    let msg='没有匹配到网页标题关键词。\n\n模糊关键词至少 3 个字，例如：\n底栏微信.png\n扫一扫.png\nscan_filled.png\n两个字请使用完整标题，如：转账.png';
    if(tooShort.length) msg+='\n\n其中 '+tooShort.length+' 张图片的关键词少于 2 个字，已跳过。';
    alert(msg);
  }
});
let fillFile=null;
document.getElementById('fillInput').addEventListener('change',e=>{fillFile=e.target.files&&e.target.files[0]||null;document.getElementById('status').textContent=fillFile?'补全图片已选择：'+fillFile.name:'已上传 '+chosen.size+' 项'});
document.getElementById('fillBtn').addEventListener('click',()=>{if(!fillFile){alert('请先选择一张“一键补全图片”');return}extraFillApplied=true;let n=0;items.forEach((it,i)=>{if(!chosen.has(i)&&!excluded.has(i)){chosen.set(i,fillFile);n++}});renderList();updateStatus();alert('已同时补全 LiquidUI + 原版微信，共 '+n+' 个空缺图标；没有网页关键词对应的命名规则也会使用这张补全图片'+(excluded.size?'；已排除的图标保持不补全':'') )});
function applySearch(){renderList()}
document.getElementById('searchInput')?.addEventListener('input',applySearch);
const colorFoldBtn=document.getElementById('colorFoldBtn');
const colorPanel=document.getElementById('colorPanel');
if(colorFoldBtn&&colorPanel){
  colorFoldBtn.addEventListener('click',()=>{
    const open=colorPanel.classList.toggle('open');
    colorFoldBtn.classList.toggle('open',open);
    colorFoldBtn.setAttribute('aria-expanded',open?'true':'false');
  });
}
