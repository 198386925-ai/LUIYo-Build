es":["点开小程序-更多-从我的小程序移除"]},{"file":"Payloading_01@3x.png","targetFile":"icons_filled_wechatpay@3x.png","mode":"normal","titles":["转账和红包下方过渡动画"]},{"file":"Payloading_02@3x.png","targetFile":"icons_filled_wechatpay@3x.png","mode":"normal","titles":["转账和红包下方过渡动画"]},{"file":"Payloading_03@3x.png","targetFile":"icons_filled_wechatpay@3x.png","mode":"normal","titles":["转账和红包下方过渡动画"]},{"file":"icons_outlined_close_8@3x.png","targetFile":"previous_filled@3x.png","mode":"normal","titles":["发送语音时取消发送"]},{"file":"icons_outlined_text_8@3x.png","targetFile":"icon_filled_convert_to_text_off@3x.png","mode":"normal","titles":["发送语音时转文字"]},{"file":"Icons_filled_voice1@3x.png","targetFile":"voice_circle_filled@3x.png","mode":"normal","titles":["选中转文字时发送原语音"]},{"file":"ui-resources_checkbox_selected_fill@3x.png","targetFile":"icons_outlined_channels_like_thick@3x.png","mode":"normal","titles":["工具栏发送照片时选择原图选中状态"]},{"file":"ui-resources_checkbox_checked@3x.png","targetFile":"icons_outlined_channels_like_thick@3x.png","mode":"normal","titles":["pkc照片加密选中状态"]},{"file":"ui-resources_checkbox_unchecked@3x.png","targetFile":"icons_outlined_channels_like_thick@3x.png","mode":"normal","titles":["pkc照片加密未选中状态"]},{"file":"ChatRoom_Bubble_HB_Overtime_Sender@3x.png","targetFile":"icons_filled_red_envelope@3x.png","mode":"normal","titles":["对方红包气泡已领取或已过期暗面"]},{"file":"ChatRoom_Bubble_Overtime_Sender_Light@3x.png","targetFile":"icons_filled_red_envelope@3x.png","mode":"normal","titles":["对方红包气泡已领取或已过期暗面"]},{"file":"ChatRoom_Bubble_HB_Sender_Handled@3x.png","targetFile":"icons_filled_red_envelope@3x.png","mode":"normal","titles":["对方红包气泡已领取或已过期暗面"]},{"file":"ChatRoom_Bubble_AA_Sender_Handled@3x.png","targetFile":"icons_filled_red_envelope@3x.png","mode":"normal","titles":["对方红包气泡已领取或已过期暗面"]},{"file":"ChatRoom_Bubble_AA_Sender@3x.png","targetFile":"icons_filled_red_envelope@3x.png","mode":"normal","titles":["对方红包已未领取状态亮面"]},{"file":"ChatRoom_Bubble_HB_Sender@3x.png","targetFile":"icons_filled_red_env