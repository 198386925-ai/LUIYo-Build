renderList();updateStatus();
function clearAll(){chosen.clear();excluded.clear();fillFile=null;extraFillApplied=false;preparedZipBlob=null;document.querySelectorAll('input[type=file]').forEach(x=>x.value='');renderList();updateStatus()}
async function drawToCanvas(file,canvasSize){
  const url=URL.createObjectURL(file);
  try{
    const im=new Image();
    await new Promise((ok,no)=>{im.onload=ok;im.onerror=no;im.src=url});
    if(canvasSize)return drawToIconCanvas(im,canvasSize[0],canvasSize[1]);
    const size=128,c=document.createElement('canvas');c.width=c.height=size;
    const x=c.getContext('2d');
    const sc=Math.min(size/im.width,size/im.height),w=im.width*sc,h=im.height*sc;
    x.drawImage(im,(size-w)/2,(size-h)/2,w,h);
    return c;
  }finally{URL.revokeObjectURL(url)}
}
// 专用画布：先按 alpha>8 裁掉透明边，再等比放进 [w,h]，四周留 6% 内边距并居中。
function drawToIconCanvas(im,width,height){
  const cap=Math.min(1,2048/Math.max(im.width,im.height));
  const sw=Math.max(1,Math.round(im.width*cap)),sh=Math.max(1,Math.round(im.height*cap));
  const src=document.createElement('canvas');src.width=sw;src.height=sh;
  const sx=src.getContext('2d',{willReadFrequently:true});sx.drawImage(im,0,0,sw,sh);
  const px=sx.getImageData(0,0,sw,sh).data;
  let left=sw,top=sh,right=-1,bottom=-1;
  for(let y=0;y<sh;y++)for(let x=0;x<sw;x++)if(px[(y*sw+x)*4+3]>8){if(x<left)left=x;if(x>right)right=x;if(y<top)top=y;if(y>bottom)bottom=y}
  if(right<left){left=0;top=0;right=sw-1;bottom=sh-1}
  const cw=right-left+1,ch=bottom-top+1;
  const c=document.createElement('canvas');c.width=width;c.height=height;
  const x=c.getContext('2d');
  const padX=width*.06,padY=height*.06,sc=Math.min((width-padX*2)/cw,(height-padY*2)/ch),w=cw*sc,h=ch*sc;
  x.drawImage(src,left,top,cw,ch,(width-w)/2,(height-h)/2,w,h);
  return c;
}
function recolorCanvas(c,hex){
  const x=c.getContext('2d'),data=x.getImageData(0,0,c.width,c.height);
  const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
  for(let i=0;i<data.data.length;i+=4){
    if(data.data[i+3]>0){data.data[i]=r;data.data[i+1]=g;data.data[i+2]=b}
  }
  x.putImageData(data,0,0);
  return c;
}
function darkenCanvas(c,factor=0.68){
  const x=c.getContext('2d'),d=x.getImageData(0,0,c.width,c.height);
  for(let i=0;i<d.data.length;i+=4){
    if(d.data[i+3]>0){
      d.data[i]=Math.round(d.data[i]*factor);
      d.data[i+1]=Math.round(d.data[i+1]*factor);
      d.data[i+2]=Math.round(d.data[i+2]*factor);
    }
  }
  x.putImageData(d,0,0);
  return c;
}
function invertCanvas(c){
  const x=c.getContext('2d'),d=x.getImageData(0,0,c.width,c.height);
  for(let i=0;i<d.data.length;i+=4){
    if(d.data[i+3]>0){d.data[i]=255-d.data[i];d.data[i+1]=255-d.data[i+1];d.data[i+2]=255-d.data[i+2]}
  }
  x.putImageData(d,0,0);
  return c;
}
function canvasBlob(c){return new Promise(ok=>c.toBlob(ok,'image/png'))}
async function toPng(file,canvas){
  const c=await drawToCanvas(file,canvas);
  if(document.getElementById('allColorEnabled').checked){
    recolorCanvas(c,document.getElementById('allColor').value||'#222222');
  }
  return await canvasBlob(c);
}
async function toSelectedPng(file,canvas){
  const c=await drawToCanvas(file,canvas);
  if(document.getElementById('selectedLightEnabled').checked){
    recolorCanvas(c,document.getElementById('selectedColor').value||'#1677ff');
  }else{
    // 未启用自定义浅色时，按之前的规则自动把选中图标加深。
    darkenCanvas(c,0.68);
  }
  return await canvasBlob(c);
}
async function toDarkPng(file, selected=false, canvas){
  const c=await drawToCanvas(file,canvas);
  if(selected){
    if(document.getElementById('selectedDarkEnabled').checked){
      recolorCanvas(c,document.getElementById('selectedDarkColor').value||'#ffffff');
      return await canvasBlob(c);
    }
    // 深色选中未自定义时：先生成浅色选中效果，再自动反转。
    if(document.getElementById('selectedLightEnabled').checked){
      recolorCanvas(c,document.getElementById('selectedColor').value||'#1677ff');
    }else{
      darkenCanvas(c,0.68);
    }
  }else if(document.getElementById('allColorEnabled').checked){
    recolorCanvas(c,document.getElementById('allColor').value||'#222222');
  }
  invertCanvas(c);
  return await canvasBlob(c);
}

async function invertPng(file){const c=await drawToCanvas(file);invertCanvas(c);return await canvasBlob(c)}
let preparedZipBlob=null;
function safeZipBaseName(v){
  let base=(v||'').trim()||'优优LUI图标包';
  base=base.replace(/[\/:*?"<>|]/g,'_').replace(/\.zip$/i,'');
  return base||'优优LUI图标包';
}
function openShareModal(){
  if(window.webkit?.messageHandlers?.zipName){window.webkit.messageHandlers.zipName.postMessage({name:safeZipBaseName(document.getElementById('zi