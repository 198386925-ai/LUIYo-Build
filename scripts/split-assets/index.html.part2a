/* The latest neutral-color adjustment applies ONLY to Solid mode. */
body.solid-card-mode #homeTools .batch,
body.solid-card-mode #homeTools .fillpick,
body.solid-card-mode #homeTools .fill,
body.solid-card-mode #homeTools .colorfold,
body.solid-card-mode #homeTools .clear,
body.solid-card-mode #homeTools .zip{
  background:#F1EFEC!important;
  color:#202832!important;
  border:0!important;
  box-shadow:none!important;
}

/* Restore a clearly visible search/input field in Solid mode. */
body.solid-card-mode #searchInput{
  background:#F1EFEC!important;
  color:#202832!important;
  border:1px solid rgba(120,120,128,.12)!important;
  box-shadow:none!important;
}
body.solid-card-mode #searchInput::placeholder{color:#A5A3A1!important}

/* Restore every image-import target in Solid mode. */
body.solid-card-mode .pick{
  background:#F7F6F3!important;
  border:1.5px dashed #D2D0CC!important;
  box-shadow:none!important;
}
body.solid-card-mode .pick:after{color:#8B95A1!important}

/* Liquid Glass / native blur must remain UIKit material, not the Solid neutral fill. */
body.native-card-glass #homeTools .batch,
body.native-card-glass #homeTools .fillpick,
body.native-card-glass #homeTools .fill,
body.native-card-glass #searchInput,
body.native-card-glass #homeTools .colorfold,
body.native-card-glass #homeTools .clear,
body.native-card-glass #homeTools .zip,
body.native-card-glass .pick,
body.native-card-glass .categorytabs button{
  background:transparent!important;
  border:0!important;
  box-shadow:none!important;
  -webkit-backdrop-filter:none!important;
  backdrop-filter:none!important;
}

/* LiquidUI / 原版微信 are TWO independent pills, never one shared capsule. */
.categorytabs{
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:10px!important;
  padding:0!important;
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  overflow:visible!important;
  box-shadow:none!important;
}
.categorytabs button{
  height:44px!important;
  border-radius:999px!important;
  overflow:hidden!important;
}
body.solid-card-mode .categorytabs button{
  background:var(--card-color,#FFFFFF)!important;
  color:#202832!important;
  border:0!important;
  box-shadow:none!important;
}
body.solid-card-mode .categorytabs button.active{
  background:#F1EFEC!important;
  color:#111820!important;
}
body.native-card-glass .categorytabs button.active,
body.native-card-glass .categorytabs button:not(.active){
  color:#202832!important;
}

/* Keep upload cards and their import targets visually distinct. */
body.solid-card-mode .card{
  background:var(--card-color,#FFFFFF)!important;
}
