</style><style id="reference-segmented-and-pill-ui-v103">
/* Pure mode = exact white cards on #F4F2EE, with no unintended border/shadow. */
body.solid-card-mode .card,
body.solid-card-mode .ruleCard,
body.solid-card-mode .settingsFold,
body.solid-card-mode #homeTools,
body.solid-card-mode .infobox,
body.solid-card-mode .ruleSearch,
body.solid-card-mode .uploadbox,
body.solid-card-mode .settingsToggleCard{
  background:var(--card-color,#FFFFFF)!important;
  box-shadow:none!important;
}

/* Reference segmented control: one soft capsule + inset white selected pill. */
.materialModePicker,
.categorytabs{
  padding:4px!important;
  gap:0!important;
  border:0!important;
  border-radius:999px!important;
  background:#F1EFEC!important;
  overflow:hidden!important;
  box-shadow:none!important;
}
.materialModePicker button,
.categorytabs button{
  border:0!important;
  border-radius:999px!important;
  background:transparent!important;
  box-shadow:none!important;
  color:#202832!important;
  transition:background-color .16s ease,color .16s ease,transform .12s ease!important;
}
.materialModePicker button.active,
.categorytabs button.active{
  background:#FFFFFF!important;
  color:#111820!important;
  box-shadow:0 1px 2px rgba(0,0,0,.035)!important;
}
.materialModePicker button:active,
.categorytabs button:active{transform:scale(.985)!important}

/* Home controls use the same fully rounded language as the category control. */
#homeTools .batch,
#homeTools .fillpick,
#homeTools .fill,
#searchInput,
#homeTools .colorfold,
#homeTools .clear,
#homeTools .zip{
  border-radius:999px!important;
}
#homeTools .colorrow{border-radius:22px!important}
#homeTools{border-radius:28px!important}
.card{border-radius:24px!important}

/* Native material mode: HTML never paints fake glass. Keep selected segmented pill white. */
body.native-card-glass .categorytabs{
  background:#F1EFEC!important;
}