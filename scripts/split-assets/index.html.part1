  width:100%!important;
  height:102px!important;
  margin:-102px 0 0!important;
  border-radius:16px!important;
}
.preview img{padding:12px!important}
.card:after{display:none!important}
.removeIcon{right:8px!important;top:8px!important;width:23px!important;height:23px!important;min-width:23px!important;font-size:16px!important}

/* Settings entry cards: noticeably shorter than the previous build. */
.settingsHead{padding-bottom:8px!important}
