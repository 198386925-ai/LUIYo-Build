#homeTools .colorfold{height:42px!important;border-radius:13px!important;margin-top:9px!important}
#homeTools .exportrow{margin-top:9px!important}
#homeTools .exportrow button{height:43px!important;border-radius:13px!important}
#homeTools .status{text-align:center!important;font-size:11px!important;margin-top:8px!important}

.categorytabs{margin:12px 0 9px!important}
.categorytabs button{height:40px!important;border-radius:13px!important}
.sectiontitle{margin:13px 2px 8px!important;font-size:12.5px!important}

.grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}
.card{
  display:block!important;
  border-radius:20px!important;
  padding:11px!important;
  min-width:0!important;
  position:relative!important;
}
