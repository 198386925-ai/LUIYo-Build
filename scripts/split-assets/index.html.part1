<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"><script id="appearance-startup-v103">
(function(){
 let mode='system';try{mode=localStorage.getItem('youyou.theme.appearance')||mode}catch(e){}
 const dark=mode==='dark'||(mode==='system'&&matchMedia('(prefers-color-scheme:dark)').matches);
 document.documentElement.dataset.appearance=dark?'dark':'light';
 document.documentElement.style.colorScheme=dark?'dark':'light';
})();
</script><title>LUIYo</title><style>
*{box-sizing:border-box}html,body{touch-action:manipulation;-webkit-text-size-adjust:100%}body{margin:0;background:#F5F3EF;color:#18202a;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.app{max-width:820px;margin:auto;padding:0 14px 30px}.top{position:sticky;top:0;z-index:5;margin:0 -14px;padding:calc(12px + env(safe-area-inset-top)) 14px 12px;background:#F5F3EF;border-bottom:1px solid #e6e8ec}.topline{display:flex;align-items:center;justify-content:space-between}.brand{font-size:22px;font-weight:800}.badge{font-size:12px;background:#202a36;color:#fff;border-radius:999px;padding:6px 9px}.sub{font-size:13px;color:#7a8491;margin-top:4px}.dashboard{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}.stat{background:#fff;border:1px solid #e8ebef;border-radius:16px;padding:13px}.stat b{display:block;font-size:14px;line-height:1.35;font-weight:800}.stat span{font-size:12px;color:#8a939f}.feedback{display:block;text-decoration:none;color:inherit;-webkit-tap-highlight-color:transparent}.feedback:active{transform:scale(.995);background:#fafbfc}.tools{background:#fff;border:1px solid #e5e8ed;border-radius:18px;padding:12px;margin-bottom:12px}.actions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}.tools label,.tools button{height:43px;border:0;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}.batch{background:#202a36;color:#fff}.fillpick{background:#edf0f4;color:#25303c}.fill{background:#dff7e6;color:#16803b}.tools input[type=file]{display:none}.search{width:100%;height:42px;border:1px solid #e3e6ea;border-radius:11px;background:#f7f8fa;padding:0 13px;font-size:14px;outline:0;margin-top:9px}
.colorfold{width:100%;height:46px;margin-top:9px;border:1px solid #e3e6ea;border-radius:11px;background:#f7f8fa;color:#1f2933;display:flex;align-items:center;justify-content:center;gap:11px;padding:0 13px;font-size:13px;font-weight:750;-webkit-tap-highlight-color:transparent}.colorfold>span:first-child{display:flex;align-items:center;justify-content:center;min-width:0}.colorfold small{font-size:10px;font-weight:500;color:#8b95a1;margin-left:8px}.colorfold .chev{position:relative;font-size:0;line-height:0;transition:transform .2s ease;display:block;width:18px;height:18px;flex:0 0 18px;margin:0;transform-origin:50% 50%}.colorfold .chev:before{content:'';position:absolute;left:50%;top:43%;width:9px;height:9px;border-right:2.5px solid #7f8994;border-bottom:2.5px solid #7f8994;border-radius:1px;transform:translate(-50%,-50%) rotate(45deg)}.colorfold.open .chev{transform:rotate(180deg)}.colorpanel{display:none}.colorpanel.open{display:block}
.colorrow{margin-top:9px;display:flex;align-items:center;justify-content:space-between;gap:10px;background:#f7f8fa;border:1px solid #e3e6ea;border-radius:11px;padding:8px 10px}.colorrow span{font-size:13px;font-weight:650}.colorrow small{display:block;color:#8b95a1;font-size:10px;margin-top:2px}.colorrow input[type=color]{width:46px;height:32px;border:0;background:transparent;padding:0;border-radius:8px;overflow:hidden}.colorcontrols{display:flex;align-items:center;gap:8px}.switchlabel{display:flex;align-items:center;gap:5px;font-size:11px;color:#68727e;white-space:nowrap}.switchlabel input{width:16px;height:16px;accent-color:#202a36}.colorrow.disabled input[type=color]{opacity:.38;pointer-events:none}.exportrow{display:flex;gap:9px;margin-top:9px}.exportrow button{height:43px;border:0;border-radius:11px;font-weight:750;font-size:13px}.exportrow .clear{width:92px;background:#eef0f3;color:#333}.exportrow .zip{flex:1;background:#202a36;color:#fff}.status{font-size:12px;color:#7d8792;margin-top:8px}.categorytabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0 10px}.categorytabs button{height:42px;border:1px solid #e2e6eb;border-radius:12px;background:#fff;color:#59636f;font-size:13px;font-weight:750}.categorytabs button.active{background:#202a36;color:#fff;border-color:#202a36}.sectiontitle{font-size:13px;font-weight:700;color:#68727e;margin:16px 2px 9px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.card{background:#fff;border:1px solid #e5e8ed;border-radius:15px;padding:10px;min-width:0;display:grid;grid-template-columns:54px 1fr;grid-template-rows:auto auto;column-gap:10px;align-items:center;position:relative}.title{grid-column:2;font-size:13px;font-weight:650;line-height:1.25;min-height:32px;display:flex;align-items:center;padding-right:24px}.pick{grid-column:1;grid-row:1/3;width:54px;height:54px;border-radius:13px;border:1px dashed #cbd1d8;background:#f7f8fa;display:flex;align-items:center;justify-content:center;font-size:0;position:relative;overflow:hidden}.pick:after{content:'+';font-size:26px;color:#8b95a1}.pick input{display:none}.preview{grid-column:1;grid-row:1/3;display:none;width:54px;height:54px;margin:0;position:relative;border-radius:13px;overflow:hidden;background:#f4f5f7;pointer-events:none}.preview img{width:100%;height:100%;object-fit:contain;padding:6px}.preview span{position:absolute;right:2px;bottom:2px;width:17px;height:17px;border-radius:50%;background:#22a652;color:#fff;font-size:0}.preview span:after{content:'✓';font-size:11px;display:flex;align-items:center;justify-content:center;height:17px}.removeIcon{position:absolute;right:8px;top:8px;width:25px;height:25px!important;min-width:25px;border:0!important;border-radius:50%!important;background:#eef0f3!important;color:#66717d!important;font-size:18px!important;font-weight:500!important;line-height:25px!important;padding:0!important;display:flex!important;align-items:center!important;justify-content:center!important;z-index:3;-webkit-tap-highlight-color:transparent}.removeIcon:active{transform:scale(.92);background:#e1e5e9!important}.card.excluded{opacity:.72}.card.excluded:after{content:'已排除 · 点击可重新上传';color:#a0a8b1}.card:after{content:'点击上传';grid-column:2;font-size:11px;color:#9aa2ac}@media(min-width:700px){.grid{grid-template-columns:repeat(3,1fr)}}

.infofolds{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 12px}.infobox{background:#fff;border:1px solid #e5e8ed;border-radius:14px;overflow:hidden}.infobox summary{list-style:none;min-height:44px;padding:0 13px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px;font-weight:750;color:#27313c;cursor:pointer;-webkit-tap-highlight-color:transparent}.infobox summary::-webkit-details-marker{display:none}.infobox summary:after{content:'';width:8px;height:8px;border-right:2px solid #8b95a1;border-bottom:2px solid #8b95a1;transform:rotate(45deg);transition:transform .18s ease;margin-right:3px;margin-top:-4px}.infobox[open] summary:after{transform:rotate(225deg);margin-top:5px}.infobody{border-top:1px solid #edf0f3;padding:12px 13px 13px;color:#66717d;font-size:12px;line-height:1.65}.infobody b{color:#27313c}.infobody p{margin:0 0 8px}.infobody p:last-child{margin-bottom:0}.infobody ul{margin:6px 0 0;padding-left:18px}.infobody li{margin:4px 0}.version{display:inline-block;margin-bottom:7px;padding:3px 7px;border-radius:999px;background:#eef1f4;color:#53606d;font-size:10px;font-weight:700}@media(max-width:430px){.infofolds{grid-template-columns:1fr}}

/* 独立底栏页面：规则 / 设置 */
#rulePage,#settingsTarget{display:none}
body.nav-rules #rulePage{display:block}
body.nav-settings #settingsTarget{display:block}
body.nav-rules #homeTarget,body.nav-rules .dashboard,body.nav-rules #homeTools,body.nav-rules .categorytabs,body.nav-rules #sectionTitle,body.nav-rules #list,body.nav-rules #settingsTarget{display:none!important}
body.nav-settings #homeTarget,body.nav-settings .dashboard,body.nav-settings #homeTools,body.nav-settings .categorytabs,body.nav-settings #sectionTitle,body.nav-settings #list,body.nav-settings #rulePage{display:none!important}
.rulePage{padding:4px 0 110px}
.pageHead{margin:8px 2px 16px}
.pageHead h1{font-size:25px;line-height:1.2;margin:0 0 5px;font-weight:800;color:#18202a}
.pageHead p{margin:0;color:#8a94a1;font-size:13px}
.ruleSearch{width:100%;height:46px;border:1px solid rgba(205,212,220,.72);border-radius:16px;padding:0 15px;margin:0 0 14px;background:#fff;font-size:14px;outline:none;box-shadow:inset 0 1px 0 rgba(255,255,255,.75)}
.ruleList{display:grid;gap:10px}
.ruleGroupTitle{font-size:13px;font-weight:750;color:#77818d;padding:10px 4px 1px}
.ruleCard{display:grid;grid-template-columns:46px minmax(0,1fr) auto;gap:11px;align-items:center;padding:13px;background:#fff;border:1px solid rgba(213,219,226,.72);border-radius:20px;box-shadow:inset 0 1px 0 rgba(255,255,255,.82),0 7px 22px rgba(31,42,55,.06)}
.ruleIcon{width:46px;height:46px;border-radius:14px;background:#f3f4f6;display:flex;align-items:center;justify-content:center;font-size:20px;color:#64707d;border:1px solid rgba(220,226,232,.7);overflow:hidden}
.ruleIcon img{width:100%;height:100%;object-fit:cover;display:none}
.ruleText{min-width:0}
.ruleName{font-size:14px;font-weight:760;color:#202832;line-height:1.35;margin-bottom:4px;overflow-wrap:anywhere}
.ruleFile{font-size:11px;color:#8a94a0;line-height:1.35;overflow-wrap:anywhere;margin-bottom:4px}
.ruleDesc{font-size:12px;color:#687482;line-height:1.5;overflow-wrap:anywhere}
.rulePick{min-width:72px;height:36px;padding:0 10px;border-radius:12px;background:#f3f4f6;border:1px solid rgba(215,221,227,.78);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:650;color:#5d6874;white-space:nowrap;cursor:pointer}
.rulePick input{display:none}
.rulePick.done{background:rgba(225,239,230,.86);color:#3b7250}
@media(max-width:390px){.ruleCard{grid-template-columns:42px minmax(0,1fr);}.ruleIcon{width:42px;height:42px}.rulePick{grid-column:1/-1;width:100%;height:34px}}

/* iOS 26+: Liquid Glass is rendered by UIKit, never by CSS. */
.appBottomNav{display:none!important}
.ruleSearch,.ruleCard,.ruleIcon,.rulePick{
  
  
}
.ruleSearch,.ruleCard{background:#fff!important;box-shadow:0 1px 3px rgba(0,0,0,.05)!important}
.ruleIcon,.rulePick{background:#f3f4f6!important}
:root[data-appearance="dark"] .ruleSearch,:root[data-appearance="dark"] .ruleCard{background:#1c1c1e!important;color:#f5f5f7!important;border-color:#343438!important}
:root[data-appearance="dark"] .ruleIcon,:root[data-appearance="dark"] .rulePick{background:#2c2c2e!important;border-color:#3a3a3c!important}
:root[data-appearance="dark"] .pageHead h1,:root[data-appearance="dark"] .ruleName{color:#f5f5f7!important}
:root[data-appearance="dark"] .pageHead p,:root[data-appearance="dark"] .ruleFile,:root[data-appearance="dark"] .ruleDesc{color:#a9a9b0!important}

/* Native-material policy: HTML never paints glass or blur. */
html,body,.top,.card,.infobox,.ruleSearch,.ruleCard,.ruleIcon,.rulePick,.settingsTarget{
  -webkit-backdrop-filter:none!important;
  backdrop-filter:none!important;
}
html,body{background:transparent!important}
.top{background:transparent!important}
.card,.infobox,.ruleSearch,.ruleCard{background:rgba(255,255,255,.34)!important;box-shadow:none!important}
.ruleIcon,.rulePick{background:rgba(255,255,255,.22)!important}
.changelog{padding:18px 22px 22px!important}
.changeVersion{padding:0 0 22px;margin:0 0 22px;border-bottom:1px solid rgba(120,120,128,.18)}
.changeVersion:last-child{border-bottom:0;margin-bottom:0;padding-bottom:0}
.changeTitle{font-size:16px;font-weight:600;color:#111;margin-bottom:15px}
.currentVersion{font-size:14px;font-weight:500;color:#0a84ff;margin-left:12px}
.changeVersion p{margin:8px 0;font-size:14px;line-height:1.65;color:#73777f}
.changeAdd{color:#34c759;font-weight:650;margin-right:5px}
.changeOptimize{color:#0a84ff;font-weight:650;margin-right:5px}
.changeFix{color:#ff9f0a;font-weight:650;margin-right:5px}
:root[data-appearance="dark"] .card,:root[data-appearance="dark"] .infobox,:root[data-appearance="dark"] .ruleSearch,:root[data-appearance="dark"] .ruleCard{background:rgba(28,28,30,.30)!important}
:root[data-appearance="dark"] .ruleIcon,:root[data-appearance="dark"] .rulePick{background:rgba(44,44,46,.25)!important}
:root[data-appearance="dark"] .changeTitle{color:#f5f5f7}
:root[data-appearance="dark"] .changeVersion p{color:#b1b1b7}

/* Button/label icons */
label.batch svg, label.fillpick svg, button.clear svg, button.zip svg, a.feedback-link svg {
  display: inline-block !important;
  vertical-align: -3px !important;
  margin-right: 6px !important;
  width: 16px !important;
  height: 16px !important;
  flex-shrink: 0;
}
label.batch, label.fillpick {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
}
button.clear, button.zip {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
}
</style><style>
.sharemodal{position:fixed;inset:0;z-index:99;background:rgba(0,0,0,.28);display:none;align-items:flex-end;justify-content:center;padding:14px}.sharemodal.show{display:flex}.sharesheet{width:min(100%,520px);background:#fff;border-radius:20px;padding:18px;box-shadow:0 18px 60px rgba(0,0,0,.18);margin-bottom:calc(10px + env(safe-area-inset-bottom))}.sharesheet h3{margin:0 0 4px;font-size:18px}.sharesheet p{margin:0 0 12px;color:#8a939f;font-size:12px}.sharesheet input{width:100%;height:46px;border:1px solid #dfe3e8;border-radius:12px;background:#f7f8fa;padding:0 12px;font-size:15px;outline:0}.shareactions{display:grid;grid-template-columns:1fr 2fr;gap:9px;margin-top:12px}.shareactions button{height:46px;border:0;border-radius:12px;font-size:14px;font-weight:750}.sharecancel{background:#eef0f3;color:#333}.sharego{background:#202a36;color:#fff}.zip[disabled]{opacity:.55}
</style><style>
/* App 悬浮底栏导航 */
body{padding-bottom:calc(92px + env(safe-area-inset-bottom))}
.appBottomNav{position:fixed;z-index:80;left:50%;bottom:calc(12px + env(safe-area-inset-bottom));transform:translateX(-50%);width:min(calc(100% - 28px),520px);height:66px;padding:7px;display:grid;grid-template-columns:repeat(3,1fr);gap:6px;background:rgba(255,255,255,.92);border:1px solid rgba(218,223,229,.92);border-radius:23px;box-shadow:0 10px 34px rgba(24,32,42,.14);}
.appBottomNav button{border:0;background:transparent;border-radius:17px;color:#7a8491;font:600 11px/1.1 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;-webkit-tap-highlight-color:transparent}
.appBottomNav button .navIcon{width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:20px;line-height:1;color:currentColor}
.appBottomNav button.active{background:#202a36;color:#fff}
.appBottomNav button:active{transform:scale(.97)}
.navTargetFlash{animation:navTargetFlash .55s ease}
@keyframes navTargetFlash{0%{box-shadow:0 0 0 0 rgba(32,42,54,.18)}100%{box-shadow:0 0 0 12px rgba(32,42,54,0)}}
</style>
<style id="approved-ui-v101">
/* Approved 1.0.1 visual pass. Glass itself is never CSS-rendered:
   iOS 26+ = UIKit UIGlassEffect; older iOS = UIKit systemMaterial. */
:root{color-scheme:light dark}
body{padding-bottom:calc(86px + env(safe-area-inset-bottom));}
.app{max-width:820px;padding:0 14px 34px}
.top{padding-top:calc(18px + env(safe-area-inset-top));padding-bottom:16px;border-bottom:1px solid rgba(120,120,128,.16)}
.brand{font-size:24px;letter-spacing:-.5px}.sub{font-size:13px}
.badge{padding:7px 12px;border-radius:999px}
.dashboard{gap:12px;margin:16px 0 14px}
.stat,.tools,.card,.settingsEntry,.ruleCard,.ruleSearch,.guideCard,.logCard{
  -webkit-backdrop-filter:none!important;backdrop-filter:none!important;
  box-shadow:none!important;border:1px solid rgba(120,120,128,.18)!important;
  background:rgba(255,255,255,.50)!important;
}
.stat{border-radius:22px;padding:16px}.tools{border-radius:24px;padding:14px}
.tools label,.tools button,.search,.colorfold,.exportrow button{border-radius:16px}
.actions{gap:9px}.search{height:46px;background:rgba(255,255,255,.34)}
.colorfold{height:50px;background:rgba(255,255,255,.34)}
.exportrow button{height:48px}.categorytabs button{border-radius:18px;height:46px}
.card{border-radius:22px;padding:12px}.pick,.preview{border-radius:16px}
.sectiontitle{font-size:15px;margin-top:18px}
.settingsTarget{display:none;padding:8px 0 110px}
body.nav-settings .settingsTarget{display:block}
.settingsHead{padding:10px 4px 18px}.settingsHead h1{margin:0 0 5px;font-size:28px;letter-spacing:-.5px}.settingsHead p{margin:0;color:#8e8e93;font-size:14px}
.settingsEntry{width:100%;min-height:84px;border-radius:24px;margin:0 0 12px;padding:14px 16px;display:grid;grid-template-columns:48px 1fr 20px;gap:12px;align-items:center;text-align:left;color:inherit}
.settingsEntryIcon{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;background:rgba(255,255,255,.38)}
.settingsEntry b{display:block;font-size:16px;margin-bottom:4px}.settingsEntry small{display:block;color:#8e8e93;font-size:12px}.settingsChevron{font-size:30px;color:#a3a3a8}
.nativeInfoPage{position:fixed;inset:0;z-index:200;display:none;overflow:auto;padding:calc(18px + env(safe-area-inset-top)) 14px calc(34px + env(safe-area-inset-bottom));background:transparent}
.nativeInfoPage.show{display:block}
.nativeInfoHeader{position:sticky;top:0;z-index:2;min-height:78px;display:flex;align-items:center;justify-content:center;margin:0 -2px 14px;padding:8px 0;background:transparent}
.nativeInfoHeader h2{font-size:24px;margin:0;font-weight:800}.nativeInfoHeader button{position:absolute;right:2px;width:54px;height:54px;border-radius:50%;border:1px solid rgba(120,120,128,.22);background:rgba(255,255,255,.52);font-size:38px;font-weight:300;line-height:1;color:inherit}
.guideCards,.logCards{display:grid;gap:12px;max-width:760px;margin:0 auto}
.guideCard{border-radius:28px;padding:16px;display:grid;grid-template-columns:48px 1fr;gap:13px;align-items:start}
.guideIcon{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:23px;background:rgba(255,255,255,.40)}
.guideCard h3{margin:2px 0 7px;font-size:16px}.guideCard p{margin:0;color:#73777f;font-size:13px;line-height:1.65}
.logCard{border-radius:30px;padding:20px}.logTitle{font-size:17px;font-weight:700;margin-bottom:14px}.logTitle span{color:#0a84ff;font-size:14px;font-weight:600;margin-left:10px}
.logCard p{margin:8px 0;color:#73777f;font-size:14px;line-height:1.62}.logCard b{margin-right:5px}.logCard .add{color:#34c759}.logCard .opt{color:#0a84ff}.logCard .fix{color:#ff9f0a}
body.info-open{overflow:hidden}
:root[data-appearance="dark"] .stat,:root[data-appearance="dark"] .tools,:root[data-appearance="dark"] .card,:root[data-appearance="dark"] .settingsEntry,:root[data-appearance="dark"] .ruleCard,:root[data-appearance="dark"] .ruleSearch,:root[data-appearance="dark"] .guideCard,:root[data-appearance="dark"] .logCard{background:rgba(28,28,30,.48)!important;border-color:rgba(255,255,255,.13)!important}
:root[data-appearance="dark"] .settingsEntryIcon,:root[data-appearance="dark"] .guideIcon,:root[data-appearance="dark"] .nativeInfoHeader button{background:rgba(44,44,46,.46)}
:root[data-appearance="dark"] .guideCard p,:root[data-appearance="dark"] .logCard p{color:#b1b1b7}
</style>
<style id="settings-modal-bugfix-v101">
/* 1.0.1 hotfix: settings must never sit under the status bar. */
.settingsTarget{padding-top:calc(10px + env(safe-area-inset-top))!important}
.settingsHead{padding-top:8px!important}
.settingsHead h1{font-size:26px!important;line-height:1.18!important}

/* Info pages are independent full-screen pages, not transparent overlays
   on top of Settings. The only blur/glass remains the native UIKit layer. */
body.info-open .app{visibility:hidden!important;pointer-events:none!important}
body.info-open .nativeInfoPage.show{visibility:visible!important;pointer-events:auto!important}
.nativeInfoPage{
  background:transparent!important;
  padding:calc(10px + env(safe-area-inset-top)) 14px calc(28px + env(safe-area-inset-bottom))!important;
}
.nativeInfoHeader{
  min-height:76px!important;
  margin:0 0 12px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
}
.nativeInfoHeader h2{font-size:19px!important;font-weight:750!important;letter-spacing:-.2px!important}
.nativeInfoHeader button{
  right:0!important;width:48px!important;height:48px!important;font-size:34px!important;
  background:rgba(255,255,255,.56)!important;box-shadow:none!important;
}
.guideCards,.logCards{gap:12px!important}
.guideCard{grid-template-columns:50px 1fr!important;gap:14px!important;border-radius:26px!important;padding:15px!important}
.guideIcon{width:50px!important;height:50px!important;font-size:22px!important}
.guideCard h3{font-size:15px!important;margin:1px 0 6px!important}
.guideCard p{font-size:12.5px!important;line-height:1.55!important}
.logCard{border-radius:28px!important;padding:18px 17px!important}
.logTitle{font-size:16px!important;margin-bottom:12px!important}
.logTitle span{font-size:12px!important}
.logCard p{font-size:13px!important;line-height:1.55!important;margin:7px 0!important}
@media (max-width:390px){
  .nativeInfoPage{padding-left:10px!important;padding-right:10px!important}
