.settingsHead p{font-size:11px!important}
.settingsFold{border-radius:17px!important;margin-bottom:8px!important}
.settingsFold summary{
  min-height:50px!important;
  padding:7px 10px!important;
  grid-template-columns:30px 1fr 12px!important;
  gap:8px!important;
}
.settingsFoldIcon{width:30px!important;height:30px!important;font-size:16px!important}
.settingsFoldText b{font-size:13px!important}
.settingsFoldText small{font-size:9.5px!important;margin-top:1px!important}
.settingsFoldChevron{width:8px!important;height:8px!important}
.settingsFoldBody{padding:11px 12px 13px!important;font-size:11.5px!important;line-height:1.52!important}
.inlineVersionTitle{font-size:13px!important}
.inlineVersion p{font-size:11.2px!important;line-height:1.5!important;margin:5px 0!important}

@media(min-width:700px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
:root[data-appearance="dark"] .homePill{background:rgba(44,44,46,.50);border-color:rgba(255,255,255,.12);color:#d1d1d6}
