  padding:12px 14px 15px!important;
  border-top:1px solid rgba(120,120,128,.12)!important;
}
.settingsFold.is-animating{will-change:height}
.settingsFold .settingsFoldChevron{transition:transform .32s cubic-bezier(.22,1,.36,1),margin .32s cubic-bezier(.22,1,.36,1)!important}
.settingsFold.is-expanded .settingsFoldChevron{transform:rotate(225deg)!important;margin-top:5px!important}
