:root[data-appearance="dark"] .card,:root[data-appearance="dark"] .infobox,:root[data-appearance="dark"] .ruleSearch,:root[data-appearance="dark"] .ruleCard,:root[data-appearance="dark"] .settingsFold,:root[data-appearance="dark"] .settingsToggleCard{background:#FFFFFF!important}
:root[data-appearance="dark"] .settingsToggleIcon{background:#F4F2EE!important}
:root[data-appearance="dark"] .settingsToggleText b,:root[data-appearance="dark"] .settingsFoldText b,:root[data-appearance="dark"] .ruleName,:root[data-appearance="dark"] .pageHead h1,:root[data-appearance="dark"] .inlineVersionTitle{color:#202832!important}
:root[data-appearance="dark"] .settingsToggleText small,:root[data-appearance="dark"] .settingsFoldText small,:root[data-appearance="dark"] .settingsFoldBody,:root[data-appearance="dark"] .ruleFile,:root[data-appearance="dark"] .pageHead p{color:#73777f!important}
</style><style id="unified-card-system-v102">
/* One visual system for Home / Rules / Settings.
   Background remains #F4F2EE in UIKit; every content card uses the same white surface. */
:root{
  --yy-page:#F4F2EE;
  --yy-card:#FFFFFF;
  --yy-card-border:transparent;
  --yy-card-radius:26px;
}
#homeTools,
.homePill,
.card,
.ruleSearch,
.ruleCard,
.settingsToggleCard,
.settingsFold,
.infobox,
.categorytabs button:not(.active){
  background:var(--yy-card)!important;
  border:1px solid var(--yy-card-border)!important;
  box-shadow:none!important;
  -webkit-backdrop-filter:none!important;
  backdrop-filter:none!important;
}
#homeTools,.ruleSearch,.ruleCard,.settingsToggleCard,.settingsFold,.infobox{
  border-radius:var(--yy-card-radius)!important;
}
.card{border-radius:var(--yy-card-radius)!important}
.homePill{border-radius:999px!important}
.categorytabs button{border-radius:22px!important}

/* Keep inner controls quieter so the outer Home card reads exactly like Settings cards. */
#homeTools .fillpick,
#searchInput,
#homeTools .colorfold,
#homeTools .colorrow,
#homeTools .clear,
.pick{
  background:#FFFFFF!important;
  border:1px solid var(--yy-card-border)!important;
  box-shadow:none!important;
}

/* Same spacing rhythm across the three tabs. */
#homeTools{padding:12px!important;margin-bottom:12px!important}
.card,.ruleCard{overflow:hidden!important}
.settingsFold,.settingsToggleCard{margin-bottom:9px!important}

/* Native iOS switch: don't impose the previous square checkbox dimensions. */
#liquidGlassToggle{
  width:auto!important;
  height:auto!important;
  margin:0!important;
  accent-color:#34c759;
}

:root[data-appearance="dark"] #homeTools,:root[data-appearance="dark"] .homePill,:root[data-appearance="dark"] .card,:root[data-appearance="dark"] .ruleSearch,:root[data-appearance="dark"] .ruleCard,:root[data-appearance="dark"] .settingsToggleCard,:root[data-appearance="dark"] .settingsFold,:root[data-appearance="dark"] .infobox,:root[data-appearance="dark"] .categorytabs button:not(.active),:root[data-appearance="dark"] #homeTools .fillpick,:root[data-appearance="dark"] #searchInput,:root[data-appearance="dark"] #homeTools .colorfold,:root[data-appearance="dark"] #homeTools .colorrow,:root[data-appearance="dark"] #homeTools .clear,:root[data-appearance="dark"] .pick{
    background:#FFFFFF!important;
    border-color:var(--yy-card-border)!important;
  }
</style><style id="unified-card-surface-v102">
/* One visual system across Home / Rules / Settings. */
:root{--app-bg:#F4F2EE!important;--surface:#FFFFFF!important;--surface-border:transparent}
html,body{background:transparent!important}

/* All content cards use the same white surface, border and curvature as Settings. */
.uploadbox,.card,.infobox,.ruleSearch,.ruleCard,.settingsFold,.settingsToggleCard,.categorytabs,.modeTabs{
  background:var(--surface)!important;
  border-color:var(--surface-border)!important;
  -webkit-backdrop-filter:none!important;
  backdrop-filter:none!important;
  box-shadow:none!important;
}
.uploadbox,.categorytabs,.modeTabs{border-radius:28px!important}
.card,.ruleCard{border-radius:24px!important}
.infobox,.settingsFold{border-radius:26px!important}
.ruleSearch{border-radius:22px!important}

/* Settings compact cards keep exactly the same shell. */
.settingsFold{margin-bottom:10px!important}
.settingsFold summary{min-height:64px!important;padding:9px 13px!important}
.settingsFoldIcon{background:#F4F2EE!important}

/* Home icon cards: same compact visual language, not a separate oversized style. */
.card{padding:12px!important}

/* Do not fake glass inside HTML. Native UIKit shell owns Liquid Glass/material. */
</style><style id="theme-settings-v102">
.themeBody{padding:4px 14px 8px!important}
.themeRow{min-height:58px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid rgba(120,120,128,.12)}
.themeRow:last-child{border-bottom:0}
.themeRow>div:first-child{min-width:0}.themeRow b{display:block;color:#202832;font-size:13.5px;line-height:1.3}.themeRow small{display:block;color:#8e8e93;font-size:10.5px;line-height:1.35;margin-top:2px}
.themeColor,.themeBorderControls{display:flex;align-items:center;gap:8px;flex:0 0 auto}
.themeColor input,.themeBorderControls input[type=color]{width:34px;height:34px;border:0;padding:0;background:transparent}
.themeColor button{border:0;background:#F4F2EE;border-radius:12px;padding:7px 9px;font-size:11px;color:#555}
#liquidGlassToggle,#cardBorderEnabled{width:auto!important;height:auto!important;margin:0!important}
</style><style id="native-fold-motion-v102">
.settingsFold summary{transition:padding .45s cubic-bezier(.16,1,.3,1)!important}
.settingsFoldBody{opacity:1;transform:none}
.settingsFold.is-animating .settingsFoldBody{will-change:opacity,transform}
.settingsFold:not(.is-expanded) .settingsFoldBody{opacity:0;transform:translateY(-6px)}
.settingsFold.is-expanded .settingsFoldBody{animation:yyFoldContentIn .42s .06s cubic-bezier(.16,1,.3,1) both}
.settingsFoldChevron{transition:transform .45s cubic-bezier(.16,1,.3,1),margin .45s cubic-bezier(.16,1,.3,1)!important}
@keyframes yyFoldContentIn{from{opacity:0;transform:translateY(-7px)}to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){.settingsFold,.settingsFold *{animation:none!important;transition:none!important}}
</style><style id="true-native-card-glass-v102">
body.native-card-glass .card,body.native-card-glass .ruleCard,body.native-card-glass .settingsFold,body.native-card-glass #homeTools,body.native-card-glass .infobox,body.native-card-glass .ruleSearch{background:transparent!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;box-shadow:none!important}
</style><style id="custom-font-theme-v102">
.themeFontControls{display:flex;align-items:center;gap:6px;flex:0 0 auto}
.themeFontControls button{border:0;background:#F4F2EE;border-radius:12px;padding:7px 9px;font-size:11px;color:#555;white-space:nowrap}
body.custom-font-active,body.custom-font-active button,body.custom-font-active input,body.custom-font-active summary{font-family:"YouYouCustomFont",-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif!important}

</style><style id="fast-fold-close-v102">
.settingsFoldBody{transition:opacity 140ms ease,transform 180ms cubic-bezier(.4,0,.6,1)!important}
.settingsFold:not(.is-expanded) .settingsFoldBody{opacity:0!important;transform:translateY(-4px)!important}
.settingsFold.is-expanded .settingsFoldBody{animation:yyFoldContentIn 220ms 35ms cubic-bezier(.2,.8,.2,1) both!important}
</style><style id="three-card-material-modes-v102">
.materialThemeRow{align-items:flex-start!important;flex-direction:column!important;padding:9px 0 10px!important;gap:8px!important}
.materialModePicker{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;width:100%;padding:3px;background:#F4F2EE;border-radius:13px}
.materialModePicker button{appearance:none;border:0!important;border-radius:10px!important;min-height:34px;padding:5px 4px!important;background:transparent!important;color:#666!important;font-size:11.5px!important;font-weight:650!important;white-space:nowrap}
.materialModePicker button.active{background:#FFFFFF!important;color:#202832!important;box-shadow:0 1px 3px rgba(0,0,0,.08)!important}
body.solid-card-mode .card,body.solid-card-mode .ruleCard,body.solid-card-mode .settingsFold,body.solid-card-mode #homeTools,body.solid-card-mode .infobox,body.solid-card-mode .ruleSearch,body.solid-card-mode .uploadbox,body.solid-card-mode .categorytabs,body.solid-card-mode .modeTabs,body.solid-card-mode .settingsToggleCard{background:#FFFFFF!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;box-shadow:none!important}
body.native-card-glass .card,body.native-card-glass .ruleCard,body.native-card-glass .settingsFold,body.native-card-glass #homeTools,body.native-card-glass .infobox,body.native-card-glass .ruleSearch,body.native-card-glass .uploadbox,body.native-card-glass .categorytabs,body.native-card-glass .modeTabs,body.native-card-glass .settingsToggleCard{background:transparent!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;box-shadow:none!important}
</style><style id="theme-color-native-home-v102">
:root{--card-color:#FFFFFF}
body.solid-card-mode .card,body.solid-card-mode .ruleCard,body.solid-card-mode .settingsFold,body.solid-card-mode #homeTools,body.solid-card-mode .infobox,body.solid-card-mode .ruleSearch,body.solid-card-mode .uploadbox,body.solid-card-mode .categorytabs,body.solid-card-mode .modeTabs,body.solid-card-mode .settingsToggleCard,
body.solid-card-mode .homePill,body.solid-card-mode #homeTools .fillpick,body.solid-card-mode #searchInput,body.solid-card-mode #homeTools .colorfold,body.solid-card-mode #homeTools .colorrow,body.solid-card-mode #homeTools .clear,body.solid-card-mode .categorytabs button:not(.active),body.solid-card-mode .pick{background:var(--card-color)!important}
body.native-card-glass .homePill,body.native-card-glass #homeTools .fillpick,body.native-card-glass #searchInput,body.native-card-glass #homeTools .colorfold,body.native-card-glass #homeTools .colorrow,body.native-card-glass #homeTools .clear,body.native-card-glass .categorytabs button:not(.active),body.native-card-glass .pick{background:transparent!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;box-shadow:none!important}
