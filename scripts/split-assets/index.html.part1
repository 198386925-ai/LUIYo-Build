</style><style id="inline-settings-rules-v101">
/* Settings cards expand in place. No modal/popup page. */
.settingsTarget{padding-top:calc(10px + env(safe-area-inset-top))!important}
.settingsFold{margin:0 0 12px;border:1px solid rgba(120,120,128,.18);border-radius:22px;overflow:hidden;background:rgba(255,255,255,.50);-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
.settingsFold summary{list-style:none;min-height:76px;padding:12px 15px;display:grid;grid-template-columns:42px 1fr 18px;gap:11px;align-items:center;cursor:pointer;-webkit-tap-highlight-color:transparent}
.settingsFold summary::-webkit-details-marker{display:none}
.settingsFoldIcon{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:21px;background:rgba(255,255,255,.38)}
.settingsFoldText b{display:block;font-size:15px;line-height:1.25}.settingsFoldText small{display:block;margin-top:3px;color:#8e8e93;font-size:11.5px;line-height:1.35}
.settingsFoldChevron{width:10px;height:10px;border-right:2px solid #9a9aa0;border-bottom:2px solid #9a9aa0;transform:rotate(45deg);transition:transform .2s ease;margin-top:-5px}
.settingsFold[open] .settingsFoldChevron{transform:rotate(225deg);margin-top:5px}
.settingsFoldBody{border-top:1px solid rgba(120,120,128,.14);padding:14px 16px 17px;color:#73777f;font-size:12.5px;line-height:1.62}
.settingsFoldBody h3{margin:0 0 8px;color:#202832;font-size:14px}.settingsFoldBody p{margin:0 0 9px}.settingsFoldBody ul{margin:7px 0 0;padding-left:20px}.settingsFoldBody li{margin:7px 0}.settingsFoldBody li b{color:#27313c}
.inlineVersion{padding:0 0 15px;margin:0 0 15px;border-bottom:1px solid rgba(120,120,128,.14)}.inlineVersion:last-child{border-bottom:0;margin:0;padding:0}
.inlineVersionTitle{font-size:15px;font-weight:700;color:#202832;margin-bottom:10px}.inlineVersionTitle span{font-size:12px;color:#0a84ff;margin-left:8px}
.inlineVersion p{margin:7px 0}.inlineVersion .add{color:#34c759}.inlineVersion .opt{color:#0a84ff}.inlineVersion .fix{color:#ff9f0a}
.nativeInfoPage{display:none!important}

/* Rules page respects the iPhone safe area and is reference-only. */
.rulePage{padding:calc(10px + env(safe-area-inset-top)) 0 110px!important}
.ruleList{gap:9px!important}.ruleGroupTitle{display:none!important}
.ruleCard{grid-template-columns:42px minmax(0,1fr)!important;gap:11px!important;padding:11px 13px!important;border-radius:18px!important}
.ruleIcon{width:42px!important;height:42px!important;border-radius:13px!important}
.ruleName{font-size:13.5px!important;margin-bottom:3px!important}.ruleFile{font-size:11.5px!important;margin:0!important;line-height:1.4!important}
.ruleDesc,.rulePick{display:none!important}
:root[data-appearance="dark"] .settingsFold{background:rgba(28,28,30,.48);border-color:rgba(255,255,255,.13)}
:root[data-appearance="dark"] .settingsFoldIcon{background:rgba(44,44,46,.46)}
:root[data-appearance="dark"] .settingsFoldBody h3,:root[data-appearance="dark"] .settingsFoldBody li b,:root[data-appearance="dark"] .inlineVersionTitle{color:#f5f5f7}
:root[data-appearance="dark"] .settingsFoldBody{color:#b1b1b7}
</style><style id="home-reference-ui-v102">
/* Homepage layout adapted from the user's index 2.html reference.
   No CSS blur/backdrop-filter: native material remains UIKit-only. */
.homeHero{padding:calc(16px + env(safe-area-inset-top)) 6px 13px}
.homeEyebrow{font-size:11px;color:#0a84ff;font-weight:750;letter-spacing:.45px}
.homeHero h1{font-size:29px;letter-spacing:-.75px;margin:4px 0 5px;line-height:1.12}
.homeSub{color:#6e6e73;font-size:13px;line-height:1.42}
.homeSummary{display:flex;flex-wrap:wrap;gap:7px;margin-top:11px}
.homePill{padding:6px 10px;border-radius:999px;border:1px solid rgba(120,120,128,.18);background:rgba(255,255,255,.54);font-size:11.5px;color:#5f6368;white-space:nowrap}
.homeFeedback{display:inline-block;margin-top:8px;font-size:11.5px;color:#0a84ff;text-decoration:none}

#homeTools{border-radius:22px!important;padding:12px!important;margin-bottom:13px!important}
