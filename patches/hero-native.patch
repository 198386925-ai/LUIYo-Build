@@ -116,10 +116,20 @@
     if (!_LUIYoHeroCustomFont) {
         _LUIYoHeroCustomFont = LUIYoLoadThemeFontFromDisk();
     }
-    NSString *name = [NSUserDefaults.standardUserDefaults stringForKey:@"youyou.hero.name"] ?: @"Liquid UI";
