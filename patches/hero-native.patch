+    }
+    cell.versionChip.textColor = textColor;
+    for (CALayer *layer in [cell.versionChip.layer.sublayers copy]) {
+        if ([layer.name isEqualToString:@"badgeGradient"]) [layer removeFromSuperlayer];
+    }
+    CAGradientLayer *gradient = [CAGradientLayer layer];
