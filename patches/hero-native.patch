+    NSString *name = [NSUserDefaults.standardUserDefaults stringForKey:@"youyou.hero.name"] ?: @"LUIYo";
+    // 会员铭牌：用 versionChip 显示（保持原始大小）
+    NSString *tier = [NSUserDefaults.standardUserDefaults stringForKey:@"youyou.auth.tier"] ?: @"free";
+    NSString *badgeText;
+    UIColor *bgStart, *bgEnd, *textColor;
+    if ([tier isEqualToString:@"svip"]) {
+        badgeText = @"👑 SVIP会员";
+        bgStart = [UIColor colorWithRed:0.20 green:0.21 blue:0.23 alpha:1.0];
+        bgEnd = [UIColor colorWithRed:0.11 green:0.12 blue:0.14 alpha:1.0];
+        textColor = [UIColor colorWithRed:0.96 green:0.82 blue:0.54 alpha:1.0];
+    } else if ([tier isEqualToString:@"vip"]) {
+        badgeText = @"👑 普通会员";
+        bgStart = [UIColor colorWithRed:0.78 green:0.60 blue:0.23 alpha:1.0];
+        bgEnd = [UIColor colorWithRed:0.64 green:0.49 blue:0.16 alpha:1.0];
+        textColor = [UIColor whiteColor];
+    } else {
+        badgeText = @"免费用户";
+        bgStart = [UIColor colorWithRed:0.29 green:0.31 blue:0.34 alpha:1.0];
+        bgEnd = [UIColor colorWithRed:0.21 green:0.23 blue:0.25 alpha:1.0];
+        textColor = [UIColor colorWithRed:0.96 green:0.97 blue:0.97 alpha:1.0];
+    }
+    NSString *deviceCode = [NSUserDefaults.standardUserDefaults stringForKey:@"youyou.device.code"] ?: @"D-000000";
+    NSString *version = [NSString stringWithFormat:@"%@ · %@", badgeText, deviceCode];
     [cell configureWithTitle:name version:version key:@"luiyo.hero.enabled"];
+    // 样式：渐变背景
+    cell.versionChip.hidden = NO;
+    cell.versionChip.textColor = textColor;
+    // 移除旧渐变
+    for (CALayer *layer in [cell.versionChip.layer.sublayers copy]) {
+        if ([layer.name isEqualToString:@"badgeGradient"]) [layer removeFromSuperlayer];
+    }
+    CAGradientLayer *gradient = [CAGradientLayer layer];
+    gradient.name = @"badgeGradient";
+    gradient.colors = @[(id)bgStart.CGColor, (id)bgEnd.CGColor];
+    gradient.startPoint = CGPointMake(0, 0.5);
+    gradient.endPoint = CGPointMake(1, 0.5);
+    gradient.cornerRadius = 9;
+    [cell.versionChip.layer insertSublayer:gradient atIndex:0];
+    // 确保渐变填满
+    dispatch_async(dispatch_get_main_queue(), ^{
+        gradient.frame = cell.versionChip.bounds;
+    });
