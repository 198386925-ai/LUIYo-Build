+    NSString *tier = [NSUserDefaults.standardUserDefaults stringForKey:@"youyou.auth.tier"] ?: @"free";
+    NSString *badgeText;
+    if ([tier isEqualToString:@"svip"]) {
+        badgeText = @"👑 SVIP会员";
+    } else if ([tier isEqualToString:@"vip"]) {
+        badgeText = @"👑 普通会员";
+    } else {
+        badgeText = @"免费用户";
+    }
+    // 设备码：从 UserDefaults 获取，后端同步时更新
+    NSString *deviceCode = [NSUserDefaults.standardUserDefaults stringForKey:@"youyou.device.code"] ?: @"D-000000";
+    NSString *version = [NSString stringWithFormat:@"%@ · %@", badgeText, deviceCode];
     [cell configureWithTitle:name version:version key:@"luiyo.hero.enabled"];
     // Use custom theme font if set, otherwise default system font.
     cell.nameLabel.font = _LUIYoHeroCustomFont ? [_LUIYoHeroCustomFont fontWithSize:18.0] : [UIFont systemFontOfSize:18 weight:UIFontWeightSemibold];
--- YouYouLUI_iOS/YouYouLUI/WebViewController.swift
+++ YouYouLUI_iOS/YouYouLUI/WebViewController.swift
@@ -33,6 +33,19 @@
         isAuthorized = allowed
         authorizationMessage = message ?? (allowed ? "已授权" : "未激活 · 仅可浏览")
         authorizationBusy = busy
+        // 保存会员等级到 UserDefaults，供原生铭牌读取
+        let msg = authorizationMessage
+        let tier: String
+        if !allowed {
+            tier = "free"
+        } else if msg.contains("永久") || msg.contains("SVIP") {
+            tier = "svip"
+        } else {
+            tier = "vip"
+        }
+        UserDefaults.standard.set(tier, forKey: "youyou.auth.tier")
