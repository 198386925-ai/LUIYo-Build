+<script>
+(function(){
+  const CROWN='<svg viewBox="0 0 24 24"><path d="M3 8l4 4 5-7 5 7 4-4v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8z"/></svg>';
+  function getDeviceCode(){
+    try{
+      const c1=localStorage.getItem('luiyo.deviceCode');if(c1)return c1;
+      if(window.__luiyoDeviceCode)return window.__luiyoDeviceCode;
+    }catch(e){}
+    return 'D-000000';
+  }
+  function getTier(){
+    // 由原生授权状态决定
+    if(window.__luiyoTier)return window.__luiyoTier;
+    return 'free';
+  }
+  function renderBadge(){
+    const tier=getTier();
+    const code=getDeviceCode();
+    const configs={free:{label:'免费用户',cls:'mb-free'},vip:{label:'普通会员',cls:'mb-vip'},svip:{label:'SVIP会员',cls:'mb-svip'}};
+    const cfg=configs[tier]||configs.free;
+    return '<span class="member-badge '+cfg.cls+'"><span class="mb-tag">'+CROWN+cfg.label+'</span><span class="mb-id">ID<span class="dot">·</span>'+code+'</span></span>';
+  }
+  function patchBrandCard(){
+    // 找到顶部品牌卡里的 Liquid UI 和 Version1.0.6 Build51
+    const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);
+    let node;
+    while(node=walker.nextNode()){
+      if(node.textContent.trim()==='Liquid UI'){
+        node.textContent='LUIYo';
+      }
+      if(node.textContent.includes('Version1.0.6 Build51')&&node.parentElement){
+        // 替换整个 pill 为铭牌
+        const pill=node.parentElement;
+        // 检查是否已经替换过
+        if(pill.querySelector('.member-badge'))continue;
+        // 创建临时容器来解析 HTML
+        const tmp=document.createElement('span');
+        tmp.innerHTML=renderBadge();
+        pill.replaceWith(tmp.firstChild);
+      }
+    }
+  }
+  // 原生授权状态更新时调用
+  window.__luiyoSetAuthorized=function(isAuthorized,message,busy){
+    let tier='free';
+    if(isAuthorized){
+      const msg=String(message||'');
+      if(msg.includes('永久')||msg.includes('SVIP'))tier='svip';
+      else tier='vip';
+    }
+    window.__luiyoTier=tier;
+    patchBrandCard();
+  };
+  window.__luiyoSetDeviceCode=function(code){
+    try{localStorage.setItem('luiyo.deviceCode',code);}catch(e){}
+    window.__luiyoDeviceCode=code;
+    patchBrandCard();
+  };
+  // 页面加载后执行，延迟确保动态内容已生成
+  function init(){
+    patchBrandCard();
+    // 监听 DOM 变化，处理动态生成的卡片
+    const obs=new MutationObserver(()=>patchBrandCard());
+    obs.observe(document.body,{childList:true,subtree:true});
+  }
+  if(document.readyState==='loading'){
+    document.addEventListener('DOMContentLoaded',()=>setTimeout(init,500));
+  }else{
+    setTimeout(init,500);
+  }
+})();
+</script>
+</body></html>
 
 
